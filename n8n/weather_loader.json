      "name": "Ask Open-Meteo"
    },
    {
      "parameters": {
        "jsCode": "// Take the lists Open-Meteo sent and make one row per day\nconst d = $input.first().json.daily;\n\nconst rows = d.time.map((day, i) => ({\n  weather_date: day,\n  latitude: 16.48,\n  longitude: 78.21,\n  temp_max_c: d.temperature_2m_max[i],\n  temp_min_c: d.temperature_2m_min[i],\n  temp_mean_c: d.temperature_2m_mean[i],\n  humidity_mean_pct: d.relative_humidity_2m_mean[i],\n  precipitation_mm: d.precipitation_sum[i]\n}));\n\nreturn rows.map(r => ({ json: r }));"
      },
